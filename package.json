{
  "name": "hc-matter",
  "version": "0.3.0",
  "description": "Matter devices in homeCore, through the Open Home Foundation Matter server",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "out/main.js",
  "files": [
    "out/**/*.js",
    "out/**/*.js.map",
    "ui/dist/**"
  ],
  "homecore": {
    "id": "plugin.matter",
    "name": "Matter",
    "category": "Devices",
    "ui": "ui/dist"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm --prefix ui ci --ignore-scripts --no-audit --no-fund && npm --prefix ui run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm --prefix ui test",
    "standin": "node standin/standin.mjs"
  },
  "dependencies": {
    "@matter-server/ws-client": "1.6.1",
    "@matter/nodejs": "0.18.1",
    "homecore-plugin-sdk": "git+https://github.com/homeCore-io/hc-plugin-sdk-js.git#v0.4.6",
    "matter-server": "1.6.1",
    "smol-toml": "^1.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@matter/main": "0.18.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
